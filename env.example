# Copy to .env (gitignored). Every value is optional: without keys Till runs in clearly labeled MOCK mode.
# Nebius Token Factory key (Builder Program). Without it a deterministic mock planner stands in for Nemotron.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Nemotron Super plans the tool calls; Nemotron Nano phrases follow-ups. Set TILL_FAST_MODEL= (empty) for Super only.
TILL_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
TILL_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Tavily search key. Without it market_check uses a SAMPLE fixture and says so in every answer.
TAVILY_API_KEY=
PORT=8765
# Optional. Speak answers in an ElevenLabs voice (falls back to the browser voice).
ELEVENLABS_API_KEY=
TILL_VOICE_ID=
